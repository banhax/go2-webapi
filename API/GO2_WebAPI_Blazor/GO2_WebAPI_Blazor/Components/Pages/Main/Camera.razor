@page "/camera"
@inject IJSRuntime JSRuntime

<PageTitle>Camera</PageTitle>

<h1>Camera</h1>

<div style="border: 3px solid #ccc; padding: 16px;">
    <video id="videoFeed" width="640" height="480" autoplay playsinline></video>
</div>

<div class="mt-2">
    <button class="btn btn-primary" @onclick="StartCamera">Start Camera</button>
    <button class="btn btn-danger" @onclick="StopCamera">Stop Camera</button>
</div>

@code {
    private async Task StartCamera()
    {
        await JSRuntime.InvokeVoidAsync("startVideo", "videoFeed");
    }

    private async Task StopCamera()
    {
        await JSRuntime.InvokeVoidAsync("stopVideo", "videoFeed");
    }
}